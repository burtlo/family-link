CONFIG_IDF_TARGET="esp32s3"
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_HEADER_FLASHSIZE_UPDATE=y

CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_BOOT_INIT=y
CONFIG_SPIRAM_USE_MALLOC=y

CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y

CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

CONFIG_LV_FONT_MONTSERRAT_14=y
CONFIG_LV_FONT_MONTSERRAT_16=y
CONFIG_LV_FONT_MONTSERRAT_32=y
CONFIG_LV_MEM_SIZE=65536

CONFIG_BSP_LCD_DRAW_BUF_HEIGHT=50

CONFIG_LAB15_SCRIPTED=n
CONFIG_LAB15_BUILD_ID="lab15-fw-manual-v1"
CONFIG_LAB15_UI_NONE=y
CONFIG_LAB15_AUDIO_PCM_RING=y
CONFIG_LAB15_PCM_RING_BYTES=5760000
CONFIG_LAB15_PEAK_ALLOC_ONLY=n
