CONFIG_IDF_TARGET="esp32s3"
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_HEADER_FLASHSIZE_UPDATE=y
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_BOOT_INIT=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_ESP_MAIN_TASK_STACK_SIZE=12288
CONFIG_LAB16_BUILD_ID="lab16-fw-v2"
CONFIG_LAB16_BOOT_SETTLE_MS=500
CONFIG_LAB16_STREAM_SECONDS=210
CONFIG_LAB16_PCM_START_LBA=2048
CONFIG_LAB16_SERVER_HOST="127.0.0.1"
CONFIG_LAB16_SERVER_PORT=8776
CONFIG_LAB16_DEVICE_TOKEN="lab16-desk-token-v1"
CONFIG_ESP_WIFI_ENABLED=y
