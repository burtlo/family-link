# Shared "Family Link device lab" menu: keep in sync with client/labs/kconfig/lab_common.projbuild

menu "Family Link device lab"

    config LAB_AUTO_HARNESS
        bool "Auto-scroll inbox after boot (scripted traversal)"
        default n
        help
            When enabled, the lab firmware auto-scrolls through the inbox after boot
            (implementation is per lab). You do not need to touch the screen during
            capture; wait for HARNESS_DONE on serial. Same option in every lab project.
            Host builds: make lab.<name>.scripted

endmenu

menu "LAB-02 Bounded Inbox"

    config LAB02_BUILD_ID
        string "Frozen LAB-02 run identity"
        default "unconfigured"

    config LAB02_SCENARIO
        string "Scripted experiment scenario"
        default "nominal"
        help
            Named host-driven experiment. S-push and S-rm-focus enable a bounded
            focus dwell after the second scripted step so a managed action can
            be observed through the next background refresh. Nominal keeps the
            existing traversal cadence.

    config LAB02_SCENARIO_DWELL_MS
        int "Mutation scenario focus dwell (ms)"
        default 6500
        range 1000 10000
        depends on LAB_AUTO_HARNESS
        help
            Bounded harness-task dwell for S-push and S-rm-focus only. This does
            not hold the LVGL lock or delay nominal traversal.

    config LAB02_EAGER_BASELINE
        bool "Eager 16-card baseline (comparison build)"
        default n
        help
            Build the eager comparison path (all cards for 16-item fixture).
            Use a separate build directory (e.g. build/labs/lab-02-bounded-inbox-eager).

    choice LAB02_FIXTURE
        prompt "Embedded inbox fixture size"
        default LAB02_FIXTURE_16
        help
            Select which embedded inbox JSON to load at boot.

        config LAB02_FIXTURE_8
            bool "8 items"
        config LAB02_FIXTURE_16
            bool "16 items"
        config LAB02_FIXTURE_64
            bool "64 items"
        config LAB02_FIXTURE_256
            bool "256 items"
    endchoice

    config LAB02_SLOW_BIND_MS
        int "Injected slow bind delay (ms), 0 = off"
        default 0
        range 0 5000
        help
            Scenario S-delay: defer label application with an LVGL timer without
            sleeping on the UI thread. Use a small value (e.g. 50) to verify
            gestures stay responsive and stale binds cannot appear.

    config LAB02_SERVER_URL
        string "Phase B paging server URL (fl.inbox-page/2)"
        default ""
        depends on !LAB02_EAGER_BASELINE
        help
            Example: http://192.168.1.42:8765
            When non-empty, firmware uses Wi-Fi and HTTP paging instead of embedded fixtures.

    config LAB02_WIFI_SSID
        string "Wi-Fi SSID (Phase B)"
        default ""
        depends on !LAB02_EAGER_BASELINE

    config LAB02_WIFI_PASSWORD
        string "Wi-Fi password (Phase B)"
        default ""
        depends on !LAB02_EAGER_BASELINE

endmenu
