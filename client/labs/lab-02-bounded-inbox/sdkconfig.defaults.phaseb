# Phase B host builds resolve per-kit Wi-Fi from the private deployment roster
# and the client URL from [labs.lab02] in host.defaults.ini.

CONFIG_ESP_WIFI_ENABLED=y
CONFIG_ESP_WIFI_STA_DISCONNECTED_PM_ENABLE=n

# Wi-Fi/IP handlers run on sys_evt; session events are large (page payload).
CONFIG_ESP_SYSTEM_EVENT_TASK_STACK_SIZE=4096
