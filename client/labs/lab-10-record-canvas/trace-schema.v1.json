{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "family-link.lab10-record-trace.schema/v1",
  "title": "Family Link LAB-10 record-canvas trace",
  "description": "Package-local trace envelope and event contract for bounded local capture. The optional audio_concurrency section is the L10-05 host-model evidence boundary; it does not authorize a server, send flow, product networking, or a hardware audio claim.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "document",
    "trace_schema",
    "run_id",
    "lab_id",
    "lab_revision",
    "firmware_build_id",
    "session_generation",
    "workload",
    "workload_metadata",
    "evidence_kind",
    "clock",
    "bounds",
    "events",
    "terminal"
  ],
  "properties": {
    "document": {
      "const": "family-link.lab10-record-trace/v1"
    },
    "trace_schema": {
      "const": "lab10-record-trace/v1"
    },
    "run_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "lab_id": {
      "const": "LAB-10"
    },
    "lab_revision": {
      "type": "string",
      "minLength": 1
    },
    "firmware_build_id": {
      "type": "string",
      "minLength": 1
    },
    "session_generation": {
      "type": "integer",
      "minimum": 1,
      "maximum": 18446744073709551614,
      "description": "Unsigned 64-bit capture generation. Generations are never reused or wrapped; the all-ones value is reserved for the internal admission-gate claim marker."
    },
    "workload": {
      "enum": [
        "manual",
        "synthetic-human-like-v1"
      ]
    },
    "workload_metadata": {
      "$ref": "#/$defs/workload_metadata"
    },
    "evidence_kind": {
      "$ref": "#/$defs/provenance"
    },
    "clock": {
      "$ref": "#/$defs/clock"
    },
    "bounds": {
      "$ref": "#/$defs/bounds"
    },
    "events": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/event"
      },
      "contains": {
        "type": "object",
        "required": ["event_name"],
        "properties": {
          "event_name": {
            "const": "terminal"
          }
        }
      },
      "minContains": 1,
      "maxContains": 1,
      "description": "Events are ordered by the declared monotonic clock. Exactly one terminal event is required; parsers must reject non-monotonic timestamps and any event after terminalization."
    },
    "terminal": {
      "$ref": "#/$defs/terminal_summary"
    },
    "audio_concurrency": {
      "$ref": "#/$defs/audio_concurrency"
    },
    "metrics": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/metric_record"
      },
      "description": "Optional parsed metric records. The exact field inventory is defined by manifest.lab.json#/metric_schema/fields."
    }
  },
  "$defs": {
    "provenance": {
      "type": "string",
      "enum": [
        "hardware",
        "host",
        "derived_static",
        "unmeasured/blocked"
      ]
    },
    "color": {
      "type": "string",
      "pattern": "^#[0-9A-Fa-f]{6}$"
    },
    "workload_metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "identity",
        "schema_version",
        "source",
        "evidence_provenance",
        "seed",
        "generator_version",
        "timestamp_jitter_bound_us",
        "declared_features"
      ],
      "properties": {
        "identity": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
        },
        "schema_version": {
          "const": "lab10-workload/v1"
        },
        "source": {
          "enum": ["manual", "synthetic"]
        },
        "evidence_provenance": {
          "$ref": "#/$defs/provenance"
        },
        "seed": {
          "type": ["integer", "null"],
          "minimum": 0,
          "maximum": 18446744073709551615
        },
        "generator_version": {
          "type": "string",
          "minLength": 1
        },
        "timestamp_jitter_bound_us": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2000
        },
        "declared_features": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "variable_spacing",
              "variable_velocity",
              "corners",
              "pauses",
              "pen_up_gaps",
              "multiple_strokes",
              "color_changes",
              "edge_points",
              "leave_reenter",
              "background_erase",
              "stop",
              "cancel"
            ]
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "source": {
                "const": "synthetic"
              }
            },
            "required": ["source"]
          },
          "then": {
            "properties": {
              "identity": {
                "pattern": "^synthetic-[A-Za-z0-9._-]+-v1$"
              },
              "evidence_provenance": {
                "const": "host"
              },
              "generator_version": {
                "const": "synthetic-human-like-v1"
              },
              "seed": {
                "type": "integer",
                "minimum": 1
              },
              "timestamp_jitter_bound_us": {
                "const": 2000
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "source": {
                "const": "manual"
              }
            },
            "required": ["source"]
          },
          "then": {
            "properties": {
              "identity": {
                "pattern": "^manual-[A-Za-z0-9._-]+$"
              },
              "seed": {
                "type": "null"
              },
              "evidence_provenance": {
                "enum": ["hardware", "unmeasured/blocked"]
              },
              "generator_version": {
                "const": "not_applicable"
              },
              "timestamp_jitter_bound_us": {
                "const": 0
              }
            }
          }
        }
      ]
    },
    "clock": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "unit",
        "timestamp_jitter_bound_us"
      ],
      "properties": {
        "source": {
          "enum": [
            "monotonic_device",
            "monotonic_host"
          ]
        },
        "unit": {
          "const": "us"
        },
        "timestamp_jitter_bound_us": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2000
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "source": {
                "const": "monotonic_device"
              }
            },
            "required": ["source"]
          },
          "then": {
            "properties": {
              "timestamp_jitter_bound_us": {
                "const": 0
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "source": {
                "const": "monotonic_host"
              }
            },
            "required": ["source"]
          },
          "then": {
            "properties": {
              "timestamp_jitter_bound_us": {
                "const": 2000
              }
            }
          }
        }
      ]
    },
    "bounds": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "lcd_width_px",
        "lcd_height_px",
        "canvas_width_px",
        "canvas_height_px",
        "rail_origin_x_px",
        "logical_width",
        "logical_height",
        "duration_cap_ms",
        "accepted_point_cap",
        "queue_capacity",
        "minimum_move_distance_px"
      ],
      "properties": {
        "lcd_width_px": {
          "const": 320
        },
        "lcd_height_px": {
          "const": 240
        },
        "canvas_width_px": {
          "const": 240
        },
        "canvas_height_px": {
          "const": 240
        },
        "rail_origin_x_px": {
          "const": 240
        },
        "logical_width": {
          "const": 120
        },
        "logical_height": {
          "const": 120
        },
        "duration_cap_ms": {
          "const": 180000
        },
        "accepted_point_cap": {
          "const": 4096
        },
        "queue_capacity": {
          "const": 16
        },
        "minimum_move_distance_px": {
          "const": 2
        }
      }
    },
    "terminal_outcome": {
      "enum": [
        "completed",
        "stopped",
        "cancelled",
        "duration_cap",
        "point_cap",
        "queue_overflow",
        "failed"
      ]
    },
    "terminal_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "event_id",
        "outcome",
        "event_count"
      ],
      "properties": {
        "event_id": {
          "type": "string",
          "pattern": "^e-[0-9]+$"
        },
        "outcome": {
          "$ref": "#/$defs/terminal_outcome"
        },
        "event_count": {
          "const": 1
        }
      }
    },
    "event": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "event_id",
        "event_name",
        "t_us",
        "provenance",
        "phase"
      ],
      "properties": {
        "event_id": {
          "type": "string",
          "pattern": "^e-[0-9]+$"
        },
        "event_name": {
          "enum": [
            "capture_started",
            "touch_report",
            "touch_accepted",
            "touch_rejected",
            "point_coalesced",
            "palette_changed",
            "stroke_started",
            "stroke_ended",
            "ui_update",
            "render_update",
            "audio_health",
            "allocation",
            "cleanup",
            "terminal",
            "trace_loss"
          ]
        },
        "t_us": {
          "type": "integer",
          "minimum": 0
        },
        "ideal_t_us": {
          "type": "integer",
          "minimum": 0,
          "description": "Synthetic source schedule before declared timestamp jitter; omitted for manual traces."
        },
        "timestamp_jitter_us": {
          "type": "integer",
          "minimum": -2000,
          "maximum": 2000,
          "description": "Synthetic timestamp minus ideal_t_us. This is a generator bound, not hardware touch latency."
        },
        "provenance": {
          "$ref": "#/$defs/provenance"
        },
        "phase": {
          "enum": [
            "NONE",
            "DOWN",
            "MOVE",
            "UP",
            "LEAVE",
            "PALETTE_CHANGE",
            "TERMINAL"
          ]
        },
        "raw_touch_id": {
          "type": ["integer", "null"],
          "minimum": 0
        },
        "raw_x": {
          "type": "integer",
          "minimum": -32768,
          "maximum": 32767
        },
        "raw_y": {
          "type": "integer",
          "minimum": -32768,
          "maximum": 32767
        },
        "display_x": {
          "type": "integer",
          "minimum": -32768,
          "maximum": 32767
        },
        "display_y": {
          "type": "integer",
          "minimum": -32768,
          "maximum": 32767
        },
        "logical_x": {
          "type": ["integer", "null"],
          "minimum": 0,
          "maximum": 119
        },
        "logical_y": {
          "type": ["integer", "null"],
          "minimum": 0,
          "maximum": 119
        },
        "accepted": {
          "type": "boolean"
        },
        "stroke_id": {
          "type": ["integer", "null"],
          "minimum": 1
        },
        "color": {
          "anyOf": [
            {
              "$ref": "#/$defs/color"
            },
            {
              "type": "null"
            }
          ]
        },
        "selected_color": {
          "$ref": "#/$defs/color"
        },
        "color_index": {
          "type": "integer",
          "minimum": 0,
          "maximum": 5
        },
        "boundary": {
          "enum": [
            "NONE",
            "STROKE_START",
            "STROKE_CONTINUE",
            "STROKE_END",
            "PEN_UP_GAP",
            "COLOR_CHANGE",
            "TERMINAL"
          ]
        },
        "pause_before_us": {
          "type": "integer",
          "minimum": 0
        },
        "pen_up_gap_before_us": {
          "type": "integer",
          "minimum": 0
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "outcome": {
          "$ref": "#/$defs/terminal_outcome"
        },
        "failure_reason": {
          "type": "string",
          "minLength": 1
        },
        "duration_us": {
          "type": "integer",
          "minimum": 0
        },
        "update_kind": {
          "enum": [
            "ink",
            "palette",
            "state",
            "cleanup"
          ]
        },
        "render_mode": {
          "enum": [
            "direct_point",
            "segment",
            "bounded_batch",
            "whole_frame"
          ]
        },
        "render_role": {
          "enum": ["control", "candidate"]
        },
        "frame_phase": {
          "enum": ["idle", "clear", "replay", "publish"]
        },
        "lock_state": {
          "enum": ["unknown", "ui_task_owned", "acquired", "released", "failed"]
        },
        "points_processed": {
          "type": "integer",
          "minimum": 0
        },
        "raster_ops": {
          "type": "integer",
          "minimum": 0
        },
        "publication_ops": {
          "type": "integer",
          "minimum": 0
        },
        "backlog_points": {
          "type": "integer",
          "minimum": 0
        },
        "raster_budget": {
          "type": "integer",
          "minimum": 1,
          "maximum": 512
        },
        "publication_budget": {
          "type": "integer",
          "minimum": 1,
          "maximum": 512
        },
        "point_budget": {
          "type": "integer",
          "minimum": 1,
          "maximum": 64
        },
        "frame_generation": {
          "type": "integer",
          "minimum": 0
        },
        "presentation_pending": {
          "type": "boolean"
        },
        "invalidation_count": {
          "type": "integer",
          "minimum": 0
        },
        "full_screen_invalidation": {
          "type": "boolean"
        },
        "audio_continuity_status": {
          "enum": [
            "continuous",
            "overrun",
            "underrun",
            "not_measured",
            "blocked"
          ]
        },
        "audio_occupancy_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "audio_high_water_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "resource": {
          "enum": [
            "sketch",
            "framebuffer",
            "pcm",
            "queue",
            "worker",
            "ui"
          ]
        },
        "bytes": {
          "type": "integer",
          "minimum": 0
        },
        "allocation_status": {
          "enum": [
            "attempted",
            "succeeded",
            "failed",
            "released"
          ]
        },
        "cleanup_kind": {
          "enum": [
            "stop",
            "cancel",
            "terminal",
            "repeated_run"
          ]
        },
        "live_resources": {
          "type": "integer",
          "minimum": 0
        },
        "lost_event_count": {
          "type": "integer",
          "minimum": 1
        },
        "terminal_event_count": {
          "const": 1
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "event_name": {
                "const": "capture_started"
              }
            },
            "required": ["event_name"]
          },
          "then": {
            "properties": {
              "phase": {
                "const": "NONE"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "event_name": {
                "enum": [
                  "touch_report",
                  "touch_accepted",
                  "touch_rejected",
                  "point_coalesced"
                ]
              }
            },
            "required": ["event_name"]
          },
          "then": {
            "required": [
              "raw_touch_id",
              "raw_x",
              "raw_y",
              "display_x",
              "display_y",
              "accepted",
              "stroke_id",
              "color"
            ],
            "properties": {
              "phase": {
                "enum": ["DOWN", "MOVE", "UP", "LEAVE"]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "event_name": {
                "const": "touch_accepted"
              }
            },
            "required": ["event_name"]
          },
          "then": {
            "required": ["logical_x", "logical_y"],
            "properties": {
              "accepted": {
                "const": true
              },
              "phase": {
                "enum": ["DOWN", "MOVE"]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "event_name": {
                "const": "touch_rejected"
              }
            },
            "required": ["event_name"]
          },
          "then": {
            "required": ["reason"],
            "properties": {
              "accepted": {
                "const": false
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "event_name": {
                "const": "point_coalesced"
              }
            },
            "required": ["event_name"]
          },
          "then": {
            "required": ["reason"],
            "properties": {
              "accepted": {
                "const": false
              },
              "phase": {
                "const": "MOVE"
              },
              "reason": {
                "const": "coalesced"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "event_name": {
                "const": "palette_changed"
              }
            },
            "required": ["event_name"]
          },
          "then": {
            "required": ["selected_color"],
            "properties": {
              "phase": {
                "const": "PALETTE_CHANGE"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "event_name": {
                "const": "stroke_started"
              }
            },
            "required": ["event_name"]
          },
          "then": {
            "required": ["stroke_id", "color"],
            "properties": {
              "phase": {
                "const": "DOWN"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "event_name": {
                "const": "stroke_ended"
              }
            },
            "required": ["event_name"]
          },
          "then": {
            "required": ["stroke_id"],
            "properties": {
              "phase": {
                "enum": ["UP", "LEAVE"]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "event_name": {
                "const": "ui_update"
              }
            },
            "required": ["event_name"]
          },
          "then": {
            "required": ["duration_us", "update_kind", "invalidation_count"],
            "properties": {
              "phase": {
                "const": "NONE"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "event_name": {
                "const": "render_update"
              }
            },
            "required": ["event_name"]
          },
          "then": {
            "required": [
              "render_mode",
              "render_role",
              "frame_phase",
              "lock_state",
              "points_processed",
              "raster_ops",
              "publication_ops",
              "backlog_points",
              "raster_budget",
              "publication_budget",
              "point_budget",
              "frame_generation",
              "invalidation_count",
              "full_screen_invalidation",
              "presentation_pending"
            ],
            "properties": {
              "phase": {
                "const": "NONE"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "event_name": {
                "const": "audio_health"
              }
            },
            "required": ["event_name"]
          },
          "then": {
            "required": [
              "audio_continuity_status",
              "audio_occupancy_bytes",
              "audio_high_water_bytes"
            ],
            "properties": {
              "phase": {
                "const": "NONE"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "event_name": {
                "const": "allocation"
              }
            },
            "required": ["event_name"]
          },
          "then": {
            "required": ["resource", "bytes", "allocation_status"],
            "properties": {
              "phase": {
                "const": "NONE"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "event_name": {
                "const": "cleanup"
              }
            },
            "required": ["event_name"]
          },
          "then": {
            "required": ["cleanup_kind", "duration_us", "live_resources"],
            "properties": {
              "phase": {
                "const": "NONE"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "event_name": {
                "const": "terminal"
              }
            },
            "required": ["event_name"]
          },
          "then": {
            "required": ["outcome", "terminal_event_count"],
            "properties": {
              "phase": {
                "const": "TERMINAL"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "event_name": {
                "const": "trace_loss"
              }
            },
            "required": ["event_name"]
          },
          "then": {
            "required": ["reason", "lost_event_count"],
            "properties": {
              "phase": {
                "const": "NONE"
              }
            }
          }
        }
      ]
    },
    "audio_concurrency": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "session_token",
        "scenario_id",
        "expected_outcome",
        "observed_outcome",
        "failure",
        "expectation_met",
        "provenance",
        "unknown_reason",
        "hardware_audio_health_measured",
        "resources_released",
        "cleanup_timestamps_recorded",
        "terminal_timestamp_us",
        "cleanup_timestamp_us",
        "metrics"
      ],
      "properties": {
        "session_token": {
          "type": "integer",
          "minimum": 1,
          "maximum": 18446744073709551615,
          "description": "Nonzero host audio-model session token returned by lab10_audio_start; tokens are never reused by one model."
        },
        "scenario_id": {
          "enum": [
            "no-stroke-control",
            "sparse-drawing",
            "continuous-drawing",
            "dense-drawing",
            "rapid-color-switching",
            "stop-during-audio",
            "cancel-during-audio",
            "audio-capture-failure",
            "allocation-failure"
          ]
        },
        "expected_outcome": {
          "enum": [
            "completed-audio-continuous",
            "completed-with-drawing-pressure",
            "stopped-and-clean",
            "cancelled-and-clean",
            "capture-failed-and-clean",
            "allocation-failed-and-clean"
          ]
        },
        "observed_outcome": {
          "enum": ["completed", "stopped", "cancelled", "failed"]
        },
        "failure": {
          "enum": ["none", "capture", "allocation", "invalid-configuration"]
        },
        "provenance": {
          "enum": ["host", "derived_static", "unmeasured/blocked"]
        },
        "unknown_reason": {
          "type": "string",
          "minLength": 1
        },
        "hardware_audio_health_measured": {
          "const": false
        },
        "resources_released": {
