          "type": "integer",
          "minimum": 0,
          "maximum": 32768
        },
        "missing_reason": {
          "type": ["string", "null"]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "provenance": {
                "const": "unmeasured/blocked"
              }
            },
            "required": ["provenance"]
          },
          "then": {
            "properties": {
              "value": {
                "type": "null"
              },
              "sample_count": {
                "const": 0
              },
              "missing_reason": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      ]
    }
