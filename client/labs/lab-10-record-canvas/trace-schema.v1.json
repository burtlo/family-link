      "synthetic_provenance": "host",
      "timestamp_jitter_rule": "actual timestamp minus ideal source schedule is bounded by ±2000 us; this bound is not a touch-latency measurement",
      "manual_rule": "manual traces use stable manual-* identities, seed=null, generator_version=not_applicable, device monotonic timestamps, and hardware provenance when hardware is actually exercised",
      "evidence_boundary": "synthetic host traces may validate generator, schema, bounds, aggregation, and deterministic renderer pressure; they must never be labeled hardware touch latency, display scanout, audio continuity, or task scheduling"
    },
    "session_generation_semantics": "session_generation is the nonzero unsigned 64-bit lab10_capture_session_id_t for this capture. It is permanently consumed, never reused, and never wrapped; generation exhaustion fails closed. The all-ones value is reserved only as an internal admission-gate claim marker and is not a valid trace generation.",
    "audio_session_token_semantics": "audio_concurrency.session_token is the nonzero per-model lab10_audio_session_token_t returned by lab10_audio_start. Each restart consumes a new token; stale worker calls are rejected and counted without changing current queues or counters.",
    "audio_cleanup_timestamp_semantics": "The host model records terminal_timestamp_us and cleanup_timestamp_us from the same deterministic monotonic schedule. cleanup_time_us is their nonnegative difference. Zero is a valid first timestamp; an allocation failure before the schedule records no timestamps and reports zero cleanup duration.",
    "phase_semantics": {
      "DOWN": "Starts one active stroke when the first touch is routed to the canvas and capacity remains.",
      "MOVE": "Belongs to the active first touch; accepted points retain stroke identity and selected color.",
      "UP": "Closes the active stroke and is a boundary event, not an additional accepted point.",
      "LEAVE": "Closes the active stroke; a later DOWN starts a new stroke.",
      "PALETTE_CHANGE": "Selects a color for subsequent points and never rewrites prior points.",
      "TERMINAL": "Ends the capture exactly once; no later point or worker mutation is valid."
    },
    "color_semantics": "Colors are six-digit display colors. Palette/rail touches may emit palette_changed but never append canvas ink; a color change applies only to subsequent points.",
    "stroke_semantics": "stroke_id is a positive per-capture identifier. Accepted DOWN/MOVE points carry the active stroke_id and color; UP/LEAVE carries the stroke being closed.",
    "coordinate_semantics": "Raw and display coordinates are retained without clamping, accepted canvas points use 0 <= x < 240 and 0 <= y < 240, and logical coordinates are floor(display/2) clamped to 0..119.",
    "coalescing_semantics": "Only a consecutive MOVE for the same stroke, selected color, and logical coordinate with Euclidean display distance < 2 px may be coalesced. DOWN, UP, color changes, logical changes, stroke boundaries, second-touch rejects, capacity outcomes, and terminal events are never coalesced.",
    "terminal_uniqueness": "The events array must contain exactly one terminal event, terminal.event_count must be 1, and the parser must reject duplicate or post-terminal terminal events.",
    "ordering_rule": "t_us is from one declared monotonic clock and must be non-decreasing in event order; wall-clock time is not valid for ordering, duration, or latency.",
    "loss_rule": "Any dropped, malformed, oversized, or otherwise missing trace event must be represented by trace_loss and makes affected measurements incomplete; loss is never zero-filled.",
    "adapter_touch_semantics": "The current LVGL adapter is single-touch and forwards touch_id=0 for canvas, rail, and palette events. Native capture tests may inject nonzero touch IDs; multi-touch hardware evidence is unmeasured/unavailable.",
    "rendering_semantics": {
      "device_default": "The normal manual and scripted firmware default is segment mode, connecting consecutive accepted points only within the same active stroke; direct_point remains an explicitly labeled control.",
      "direct_point": "Control mode consumes at most one accepted point per update and publishes one logical pixel without interpolation.",
      "segment": "Candidate mode consumes at most one accepted point per update and rasterizes only a same-stroke, same-color Bresenham segment in bounded steps.",
      "bounded_batch": "Candidate mode uses the segment rule with independent point, raster, and publication budgets.",
      "whole_frame": "Candidate mode stages bounded clear/replay work in a second logical framebuffer and publishes bounded chunks; it never replays the full history or publishes all 120x120 pixels in one update.",
      "publication": "Each published logical pixel is the only input to the LVGL adapter, which expands it to a fixed 2x2 display block. Host callbacks expose raster, publication, invalidation, backlog, and lock-state observations.",
      "evidence_boundary": "Host mode equivalence and work bounds do not establish touch latency, display scanout, LVGL lock timing, visual fidelity, or hardware performance."
    }
