CONFIG_IDF_TARGET="esp32s3"
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_HEADER_FLASHSIZE_UPDATE=y

CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_BOOT_INIT=y
CONFIG_SPIRAM_USE_MALLOC=y

CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y

CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
# The package's flash contract is the package-local partitions.csv.  Keep the
# partition-type choice custom and do not also select a built-in single-app
# layout.

CONFIG_LV_FONT_MONTSERRAT_14=y
CONFIG_LV_FONT_MONTSERRAT_16=y
CONFIG_LV_FONT_MONTSERRAT_20=y
CONFIG_LV_FONT_MONTSERRAT_24=y

# The Box-3 BSP uses a partial internal DMA buffer; keep the UI project aligned
# with the known LAB-03 hardware profile without allocating a record framebuffer.
CONFIG_BSP_LCD_DRAW_BUF_HEIGHT=50

CONFIG_LAB10_SCRIPTED=n
CONFIG_LAB10_BUILD_ID="lab10-render-l10-04-segment-default"
CONFIG_LAB10_RENDER_MODE_SEGMENT=y
CONFIG_LAB10_RENDER_MAX_POINTS_PER_UPDATE=8
CONFIG_LAB10_RENDER_MAX_RASTER_OPS_PER_UPDATE=32
CONFIG_LAB10_RENDER_MAX_PUBLICATION_OPS_PER_UPDATE=32
