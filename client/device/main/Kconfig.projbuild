menu "Family Link product login"

config FAMILY_P1_BASE_URL
    string "P1 API base URL for desk/host tests"
    default "http://127.0.0.1:8777"

config FAMILY_DESK_TOKEN
    string "Desk bearer token (leave empty to read NVS stub family_link/desk_token)"
    default ""

config FAMILY_WIFI_SSID
    string "Desk Wi-Fi SSID (injected by make app KIT=<nickname>)"
    default ""

config FAMILY_WIFI_PASSWORD
    string "Desk Wi-Fi password"
    default ""

config FAMILY_DEVICE_MEM_DIAGNOSTIC
    bool "Log DMA largest free block around display init"
    default n
    help
        When enabled, app_main logs the largest internal DMA block before
        display init, then that block plus lv_mem_monitor after display init.
        Log only. There is no numeric boot assert and no CI gate.

config FAMILY_DEVICE_MUTE_TRACE
    bool "Verbose mute latch and display diagnostics (serial)"
    default n
    help
        Logs V2_MUTE_EDGE on every latch transition and V2_MUTE_TICK every
        2 s while the login backlight is marked dark. Filter serial on tag
        product_mute. Latch edges are also logged when this is off.

endmenu
