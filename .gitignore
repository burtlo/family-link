poc-v1/data/
poc-v1/.venv/
poc-v1/firmware/managed_components/
poc-v1/firmware/assets/persona/
poc-v1/demos/server/h18_playback/assets/*.wav
poc-v1/*.local.yaml
poc-v1/sdkconfig
poc-v1/sdkconfig.old
poc-v1/sdkconfig.local
poc-v1/build/
