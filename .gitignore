.venv/
build/
artifacts/
logs/

# Ephemeral make lab.<name> canonical runs (YYYYMMDD + 10 hex). Named evidence (e.g. w8-manual-01) stays committable.
docs/labs/evidence/**/runs/[0-9][0-9][0-9][0-9][0-9][0-9][0-9][0-9]-[0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f]/

client/device/sdkconfig
client/device/sdkconfig.old
client/device/managed_components/

# v2 lab firmware (ESP-IDF local trees; sources under client/labs/ are tracked)
client/labs/*/sdkconfig
client/labs/*/sdkconfig.old
client/labs/*/dependencies.lock
client/labs/*/managed_components/
__pycache__/
*.py[cod]
*.egg-info/
.DS_Store
Thumbs.db

# Environment / secrets
.env
.env.*
.envrc

# Keys & certs (dev_https writes data/certs/)
*.bin
*.pem
*.key
*.p12
*.pfx
secrets/
credentials.json
*-credentials.json

# Local config overrides (real tokens, PINs, Wi-Fi, kit USB map)
*.local.yaml
config/deployment/local.yaml

data/

