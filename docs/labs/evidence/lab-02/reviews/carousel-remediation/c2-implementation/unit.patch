+        view->pending_revision = slot->inbox_revision;
+        view->pending_bind = true;
+        lv_timer_reset(view->bind_timer);
+        lv_timer_resume(view->bind_timer);
+    } else apply_bind_labels(view, slot->item);
+#else
+    apply_bind_labels(view, slot->item);
+#endif
+}
