# h32-only overlay. Passed after sdkconfig.defaults into a dedicated build tree.
# It does not select a production partition layout.
# First outbox FAT format can exceed the 60s task-WDT cap; disable task WDT for this island only.
# CONFIG_ESP_TASK_WDT_EN is not set
CONFIG_ESP_MAIN_TASK_STACK_SIZE=16384
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions/h32_onchip_storage.csv"
# CONFIG_PARTITION_TABLE_SINGLE_APP_LARGE is not set
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_WL_SECTOR_SIZE_4096=y
# CONFIG_FATFS_LFN_NONE is not set
CONFIG_FATFS_LFN_HEAP=y
CONFIG_FATFS_MAX_LFN=64
CONFIG_FATFS_PER_FILE_CACHE=y
