{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "family-link.deployment.schema/v1",
  "title": "Family Link deployment roster",
  "description": "Structural contract for config/deployment/example.yaml and config/deployment/local.yaml. Cross-field rules (unique tokens, kit coverage, peer links) are enforced by scripts/deployment_config.py after schema validation.",
  "type": "object",
  "required": ["deployment", "endpoints", "kits"],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string",
      "minLength": 1,
      "description": "Optional pointer to this file for editors and tooling."
    },
    "deployment": {
      "type": "object",
      "required": ["id", "name"],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "name": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "users": {
      "type": "array",
      "items": { "$ref": "#/$defs/user" }
    },
    "endpoints": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/endpoint" }
    },
    "kits": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/kit" }
    },
    "aliases": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "minLength": 1,
        "pattern": "^[a-z][a-z0-9-]*$"
      },
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "$defs": {
    "user": {
      "type": "object",
      "required": ["id"],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "name": { "type": "string" },
        "pin": { "type": "string" },
        "web_admin": { "type": "boolean", "default": false },
        "web_password": { "type": "string" }
      }
    },
    "endpoint": {
      "type": "object",
      "required": ["id", "token", "hangout_id"],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "name": { "type": "string" },
        "token": {
          "type": "string",
          "minLength": 1
        },
        "hangout_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "peer": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$"
        }
      }
    },
    "kit": {
      "type": "object",
      "required": ["id", "endpoint_id"],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "endpoint_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "secrets_profile": { "type": "string" },
        "usb_serial": { "type": "string" }
      }
    }
  }
}
