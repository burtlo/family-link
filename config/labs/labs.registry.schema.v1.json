{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "family-link.labs-registry.schema/v1",
  "title": "Family Link device labs registry",
  "description": "Structural contract for config/labs.registry.yaml. Repo-relative paths, existing project trees, variant defaults, and optional trace_parser files are enforced by scripts/lab_registry.py after schema validation.",
  "type": "object",
  "required": ["document", "labs"],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string",
      "minLength": 1,
      "description": "Optional pointer to this file for editors and tooling."
    },
    "document": {
      "type": "string",
      "const": "family-link.labs-registry/v1"
    },
    "labs": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9]*$"
      },
      "additionalProperties": {
        "$ref": "#/$defs/lab_entry"
      }
    }
  },
  "$defs": {
    "lab_entry": {
      "type": "object",
      "required": ["project_dir", "variants"],
      "additionalProperties": false,
      "properties": {
        "lab_id": {
          "type": "string",
          "pattern": "^LAB-[0-9]{2}$"
        },
        "evidence_slug": {
          "type": "string",
          "pattern": "^lab-[0-9]{2}(-[a-z0-9-]+)?$"
        },
        "project_dir": {
          "type": "string",
          "minLength": 1
        },
        "target": {
          "type": "string",
          "minLength": 1,
          "default": "esp32s3"
        },
        "description": {
          "type": "string"
        },
        "adapter": {
          "type": "string",
          "enum": ["generic", "lab02", "lab03", "lab04", "lab07", "lab10"],
          "default": "generic",
          "description": "Host-code adapter key resolved by the fixed lab runner allowlist."
        },
        "variants": {
          "$ref": "#/$defs/variants_map"
        },
        "trace_parser": {
          "type": "string",
          "minLength": 1
        },
        "workflow": {
          "$ref": "#/$defs/workflow_settings"
        },
        "run": {
          "$ref": "#/$defs/run_defaults"
        }
      }
    },
    "workflow_settings": {
      "type": "object",
      "additionalProperties": false,
      "required": ["server_path", "bind_host", "bind_port", "fixture_size_default", "scenario_default", "deadlines_seconds"],
      "properties": {
        "server_path": { "type": "string", "minLength": 1 },
        "bind_host": { "type": "string", "minLength": 1 },
        "bind_port": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "fixture_size_default": { "type": "integer", "enum": [8, 16, 64, 256] },
        "scenario_default": {
          "type": "string",
          "enum": ["nominal", "S-fix-8", "S-fix-16", "S-fix-64", "S-fix-256", "S-trav-20", "S-rev", "S-delay", "S-push", "S-rm-focus", "S-page-snap"]
        },
        "deadlines_seconds": {
          "type": "object",
          "additionalProperties": false,
          "required": ["startup", "health", "seed", "readiness", "action", "cleanup"],
          "properties": {
            "startup": { "type": "integer", "minimum": 1 },
            "health": { "type": "integer", "minimum": 1 },
            "seed": { "type": "integer", "minimum": 1 },
            "readiness": { "type": "integer", "minimum": 1 },
            "action": { "type": "integer", "minimum": 1 },
            "cleanup": { "type": "integer", "minimum": 1 }
          }
        }
      }
    },
    "variants_map": {
      "type": "object",
      "minProperties": 2,
      "required": ["default"],
      "properties": {
        "default": {
          "type": "string",
          "minLength": 1
        }
      },
      "patternProperties": {
        "^(?!default$)[a-z][a-z0-9_-]*$": {
          "$ref": "#/$defs/variant_build"
        }
      },
      "additionalProperties": false
    },
    "variant_build": {
      "type": "object",
      "required": ["build_dir"],
      "additionalProperties": false,
      "properties": {
        "build_dir": {
          "type": "string",
          "minLength": 1
        },
        "sdkconfig_defaults": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "run_defaults": {
      "type": "object",
      "additionalProperties": false,
      "anyOf": [
        { "required": ["instructions"] },
        { "required": ["instructions_doc"] }
      ],
      "properties": {
        "capture_seconds_default": {
          "type": "integer",
          "minimum": 1,
          "description": "Serial capture duration for make lab.<name>; shown in operator help. Override with SECONDS=."
        },
        "flash_by_default": {
          "type": "boolean"
        },
        "instructions": {
          "type": "string",
          "minLength": 1,
          "description": "Short operator steps printed by make lab.<name> and make lab.<name>.help."
        },
        "instructions_doc": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[^#\\s]+\\.md(#[\\w-]+)?$",
          "description": "Repo-relative markdown path with optional #anchor for extended runbook."
        }
      }
    }
  }
}
